# Local development values. Replace every placeholder before production use.
NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# MONGO_URI is preferred; MONGODB_URI remains supported as an alias.
MONGO_URI=mongodb://127.0.0.1:27017/portfolio

# Generate two different random secrets, each at least 32 characters.
JWT_SECRET=replace_with_a_unique_random_secret_at_least_32_characters
JWT_REFRESH_SECRET=replace_with_a_different_random_secret_at_least_32_characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Frontend origin(s); production requires HTTPS origins and exact matches.
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# Required for shared rate limits on serverless deployments such as Vercel.
# Keep the REST token in backend environment settings only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Required by npm run seed and npm run reset-admin; replace both example values.
SEED_ADMIN_NAME=Portfolio Admin
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=replace_with_a_unique_password_of_at_least_12_characters

# Optional contact email delivery. Configure all four values or leave all blank.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_RECEIVER_EMAIL=

# Optional server-side integrations.
GITHUB_USERNAME=
GITHUB_TOKEN=
GITHUB_CACHE_TTL_SECONDS=900
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_ENABLED=true
# Third-party provider calls default off in production; explicitly enable only with provider-side spend controls.
AI_PROVIDER_ENABLED=true
AI_TIMEOUT_MS=8000
AI_MAX_CONCURRENT=4
PUBLIC_API_URL=

# Media storage. Local is convenient for development; production requires an explicitly persistent volume.
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=./uploads
LOCAL_STORAGE_PERSISTENT=false

# Set STORAGE_PROVIDER=cloudinary for Vercel production. Direct browser uploads use server-generated,
# short-lived signatures; configure the Cloudinary account's upload-size limit and CORS for the frontend.
# Keep the API secret exclusively in backend environment settings. Never use a VITE_ variable.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional S3-compatible storage for existing non-Vercel deployments. Direct uploads require bucket CORS,
# method PUT, and headers Content-Type and If-None-Match. Keep credentials in backend settings only.
# S3_ENDPOINT is optional (use for S3-compatible services such as R2/MinIO; HTTPS required).
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=
S3_PUBLIC_URL=
